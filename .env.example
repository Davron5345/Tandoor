PORT=3001
NODE_ENV=production

# Разрешённые origins для CORS (через запятую). Для отдельного фронта на другом домене.
# На Railway с одним сервисом можно не задавать — домен подставится из RAILWAY_PUBLIC_DOMAIN.
# CORS_ORIGIN=https://your-app.example.com

# Постоянная папка для uploads и (при SQLite) warehouse.db
# Локально можно не задавать — используется ./data
# Railway: смонтируйте Volume и укажите:
# DATA_DIR=/data

# DATA_DIR=/data
# DISABLE_DEMO_SEED=true

# --- База данных ---
# Postgres (Railway): задайте DATABASE_URL — приложение переключится с sql.js на pg.
# Без DATABASE_URL остаётся SQLite-файл data/warehouse.db (удобно для отката).
# DATABASE_URL=postgresql://user:pass@host:5432/railway
#
# Локальные тесты без Docker Postgres:
# DATABASE_URL=pglite
# DB_ENGINE=pglite
#
# Принудительно SQLite даже если DATABASE_URL задан:
# DB_ENGINE=sqlite

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ENABLED=true

# Push-уведомления для мобильного приложения снабженца (PWA)
# Сгенерировать: node server/scripts/generate-vapid.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.com

# FCM (Android APK)
# FCM_SERVER_KEY=

# CAPACITOR_SERVER_URL=
# SNAB_APK_URL=
# APP_PUBLIC_URL=
# COOKIE_SECURE=true
# ALLOW_DATA_RESET=false
